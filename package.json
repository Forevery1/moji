  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "start": "open release/macos/墨记.app",
    "build": "npm run themes:build && vite build",
    "test": "playwright test",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
