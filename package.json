    "@codemirror/view": "^6.43.15",
    "@lezer/markdown": "^1.8.1",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@tauri-apps/api": "^2.12.4",
    "dompurify": "^3.4.17",
    "express": "^5.0.0",
    "lucide-react": "^0.577.0",
    "marked": "^18.1.3",
    "mermaid": "11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
