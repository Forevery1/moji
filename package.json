    "app": "tauri dev",
    "build:mac": "tauri build --bundles app",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "web:dev": "node legacy/server.mjs --dev",
    "web:start": "node legacy/server.mjs",
    "test:core": "node --test tests/*.test.mjs",
    "themes:build": "node script/build_themes.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
